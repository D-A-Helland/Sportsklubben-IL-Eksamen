generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id       Int     @id @default(autoincrement())
  username String? @unique @db.VarChar(63)
  password String? @db.VarChar(127)
  role     String? @db.VarChar(31)
}
