generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model brukere {
  id           Int       @id @default(autoincrement())
  navn         String
  epost        String    @unique
  tlf          String?
  passord_hash String
  godkjent     Boolean   @default(false)
  rolle        String    @default("bruker")
  tickets      tickets[]
}

model tickets {
  id         Int       @id @default(autoincrement())
  godkjent   Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  bruker_id  Int
  brukere    brukere   @relation(fields: [bruker_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bruker_tickets")
}
