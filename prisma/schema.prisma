generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model brukere {
  id           Int       @id @default(autoincrement())
  navn         String
  epost        String    @unique
  tlf          String?
  passord_hash String
  rolle        String    @default("bruker")
  tickets      tickets[]
}

model tickets {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now()) @db.Timestamp(6)
  bruker_id  Int       @unique
  brukere    brukere   @relation(fields: [bruker_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bruker_tickets")
}
