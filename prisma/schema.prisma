generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model brukere {
  id           Int           @id @default(autoincrement())
  navn         String
  epost        String        @unique
  tlf          String?
  passord_hash String
  rolle        String        @default("bruker")
  bruker_kurs  bruker_kurs[]
  tickets      tickets[]
}

model tickets {
  id         Int       @id @default(autoincrement())
  godkjent   Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  bruker_id  Int
  brukere    brukere   @relation(fields: [bruker_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bruker_tickets")
}

model bruker_kurs {
  id        Int     @id @default(autoincrement())
  bruker_id Int
  kurs_id   Int
  brukere   brukere @relation(fields: [bruker_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bruker_kurs")
  kurs      kurs    @relation(fields: [kurs_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "kurs_bruker")

  @@unique([bruker_id, kurs_id], map: "unique_bruker_per_kurs")
}

model kurs {
  id          Int           @id @default(autoincrement())
  navn        String
  referanse   String?
  bruker_kurs bruker_kurs[]
}
