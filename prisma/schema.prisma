generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model brukere {
  id           Int     @id @default(autoincrement())
  navn         String  @db.VarChar(255)
  tlf          String? @db.VarChar(50)
  epost        String  @unique @db.VarChar(255)
  passord_hash String
  rolle        String  @default("user") @db.VarChar(50)
}
